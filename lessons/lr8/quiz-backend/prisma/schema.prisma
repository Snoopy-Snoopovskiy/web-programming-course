generator client {
  provider = "prisma-client-js"
    output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  githubId  Int      @unique
  createdAt DateTime @default(now())
}
