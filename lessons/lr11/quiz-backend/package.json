{
  "name": "quiz-backend",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "test:unit": "vitest run --reporter=verbose",
    "test:feature": "vitest run --reporter=verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci:local:win": "powershell -ExecutionPolicy Bypass -File .\\scripts\\local-release.ps1"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@prisma/adapter-libsql": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "dotenv": "^17.3.1",
    "hono": "^4.11.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.17",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.1.0",
    "prisma": "^7.5.0",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18",
    "vitest-mock-extended": "^3.1.0"
  }
}
